{
  "name": "redsun-remote-control",
  "version": "0.3.0",
  "description": "Passkey-protected remote control companion for a redsun host",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/and2049/redsun-remote-control.git" },
  "type": "module",
  "engines": { "bun": ">=1.3.0" },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
